<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= product.name %> - IT Store</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
  <nav class="navbar navbar-dark bg-dark">
    <div class="container">
      <a class="navbar-brand fw-bold" href="/">🖥️ IT Store</a>
      <a class="btn btn-outline-light btn-sm" href="/">← กลับหน้าร้าน</a>
    </div>
  </nav>

  <div class="container my-5">
    <div class="card shadow-sm border-0 p-4">
      <div class="row g-4 align-items-center">
        <div class="col-md-5">
          <img src="<%= product.imageUrl %>" class="img-fluid rounded" alt="<%= product.name %>" onerror="this.src='https://placehold.co/600x400?text=IT+Store'">
        </div>
        <div class="col-md-7">
          <span class="badge bg-primary mb-2"><%= product.category %></span>
          <h2 class="fw-bold"><%= product.name %></h2>
          <h3 class="text-danger fw-bold my-3">฿<%= (product.price || 0).toLocaleString() %></h3>
          <p class="text-secondary"><%= product.description || 'ไม่มีรายละเอียดเพิ่มเติม' %></p>
          <p class="fw-semibold">จำนวนในสต็อก: <span class="text-success"><%= product.stock %> ชิ้น</span></p>
          <hr>
          <form action="/cart/add/<%= product._id %>" method="POST" class="d-flex gap-2">
            <button type="submit" class="btn btn-primary btn-lg" <%= product.stock <= 0 ? 'disabled' : '' %>>
              🛒 เพิ่มลงตะกร้าสินค้า
            </button>
            <a href="/" class="btn btn-outline-secondary btn-lg">เลือกซื้อสินค้าอื่น</a>
          </form>
        </div>
      </div>
    </div>
  </div>
</body>
</html>