<%- include('partials/header') %>
<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm p-4">
            <h3 class="fw-bold mb-3">💳 ชำระเงินและยืนยันคำสั่งซื้อ</h3>
            <p class="text-muted">ยอดที่ต้องชำระทั้งหมด: <strong class="text-danger fs-4">฿<%= cart.totalPrice.toLocaleString() %></strong></p>
            <hr>

            <!-- ส่งข้อมูลออเดอร์ไปให้เพื่อนบันทึกเข้า Collection 'orders' ใน MongoDB -->
            <form action="/checkout" method="POST" enctype="multipart/form-data">
                <h5 class="fw-bold mb-3">1. ข้อมูลผู้รับสินค้า</h5>
                <div class="mb-3">
                    <label class="form-label">ชื่อ-นามสกุล ผู้รับ</label>
                    <input type="text" name="customerName" class="form-control" required placeholder="เช่น สมชาย ใจดี">
                </div>
                <div class="mb-3">
                    <label class="form-label">เบอร์โทรศัพท์</label>
                    <input type="tel" name="phone" class="form-control" required placeholder="08X-XXX-XXXX">
                </div>
                <div class="mb-4">
                    <label class="form-label">ที่อยู่จัดส่ง</label>
                    <textarea name="address" class="form-control" rows="2" required placeholder="บ้านเลขที่, ถนน, แขวง/ตำบล, เขต/อำเภอ, จังหวัด, รหัสไปรษณีย์"></textarea>
                </div>

                <h5 class="fw-bold mb-3">2. เลือกวิธีการชำระเงิน (3 ช่องทาง)</h5>

                <!-- วิธีที่ 1: บัตรเครดิต / เดบิต -->
                <div class="payment-option mb-3" onclick="selectPayment('credit')">
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="paymentMethod" id="payCredit" value="Credit Card" checked>
                        <label class="form-check-label fw-bold" for="payCredit">
                            💳 บัตรเครดิต / บัตรเดบิต (Credit / Debit Card)
                        </label>
                    </div>
                    <div id="credit-details" class="mt-3 ps-4" onclick="event.stopPropagation()">
                        <div class="row g-2">
                            <div class="col-12">
                                <input type="text" class="form-control form-control-sm" placeholder="หมายเลขบัตร 16 หลัก (XXXX-XXXX-XXXX-XXXX)">
                            </div>
                            <div class="col-6">
                                <input type="text" class="form-control form-control-sm" placeholder="วันหมดอายุ (MM/YY)">
                            </div>
                            <div class="col-6">
                                <input type="text" class="form-control form-control-sm" placeholder="รหัสหลังบัตร (CVV)">
                            </div>
                        </div>
                    </div>
                </div>

                <!-- วิธีที่ 2: พร้อมเพย์ (PromptPay) -->
                <div class="payment-option mb-3" onclick="selectPayment('promptpay')">
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="paymentMethod" id="payPromptpay" value="PromptPay">
                        <label class="form-check-label fw-bold" for="payPromptpay">
                            📱 สแกน QR พร้อมเพย์ (PromptPay)
                        </label>
                    </div>
                    <div id="promptpay-details" class="mt-3 text-center d-none" onclick="event.stopPropagation()">
                        <p class="small text-muted mb-2">สแกน QR Code ด้านล่างผ่านแอปธนาคารเพื่อชำระเงิน</p>
                        <img src="https://api.qrserver.com/v1/create-qr-code/?size=160x160&data=PromptPay-iTechStore-<%= cart.totalPrice %>" alt="QR PromptPay" class="border p-2 bg-white">
                        <p class="small fw-bold text-danger mt-2">ยอดโอน: ฿<%= cart.totalPrice.toLocaleString() %></p>
                        <div class="text-start mt-3">
                            <label class="form-label small fw-bold">แนบสลิปโอนเงิน (PromptPay)</label>
                            <input type="file" id="slipPromptpay" name="slipPromptpay" accept="image/*" class="form-control form-control-sm">
                        </div>
                    </div>
                </div>

                <!-- วิธีที่ 3: โอนเงินผ่านธนาคาร -->
                <div class="payment-option mb-4" onclick="selectPayment('bank')">
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="paymentMethod" id="payBank" value="Bank Transfer">
                        <label class="form-check-label fw-bold" for="payBank">
                            🏦 โอนเงินผ่านบัญชีธนาคาร (กสิกรไทย / ไทยพาณิชย์)
                        </label>
                    </div>
                    <div id="bank-details" class="mt-2 ps-4 small text-muted d-none" onclick="event.stopPropagation()">
                        <div>ธนาคารกสิกรไทย: <strong>123-4-56789-0</strong> ชื่อบัญชี บจก. ไอเทค สโตร์</div>
                        <div class="mt-3">
                            <label class="form-label small fw-bold text-dark">แนบสลิปโอนเงิน (โอนเงินผ่านธนาคาร)</label>
                            <input type="file" id="slipBank" name="slipBank" accept="image/*" class="form-control form-control-sm">
                        </div>
                    </div>
                </div>

                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-red btn-lg">ยืนยันการสั่งซื้อและชำระเงิน</button>
                    <a href="/cart" class="btn btn-outline-secondary">ย้อนกลับไปตะกร้า</a>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- สคริปต์สลับหน้าต่างรายละเอียดการจ่ายเงิน -->
<script>
    function selectPayment(type) {
        document.getElementById('credit-details').classList.add('d-none');
        document.getElementById('promptpay-details').classList.add('d-none');
        document.getElementById('bank-details').classList.add('d-none');

        const slipPromptpay = document.getElementById('slipPromptpay');
        const slipBank = document.getElementById('slipBank');

        if (type === 'credit') {
            document.getElementById('payCredit').checked = true;
            document.getElementById('credit-details').classList.remove('d-none');
            if (slipPromptpay) slipPromptpay.value = '';
            if (slipBank) slipBank.value = '';
        } else if (type === 'promptpay') {
            document.getElementById('payPromptpay').checked = true;
            document.getElementById('promptpay-details').classList.remove('d-none');
            if (slipBank) slipBank.value = '';
        } else if (type === 'bank') {
            document.getElementById('payBank').checked = true;
            document.getElementById('bank-details').classList.remove('d-none');
            if (slipPromptpay) slipPromptpay.value = '';
        }
    }
</script>

<%- include('partials/footer') %>