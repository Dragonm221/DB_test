<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ตะกร้าสินค้า - IT Store</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
  <nav class="navbar navbar-dark bg-dark">
    <div class="container">
      <a class="navbar-brand fw-bold" href="/">🖥️ IT Store</a>
      <a class="btn btn-outline-light btn-sm" href="/">← เลือกซื้อสินค้าต่อ</a>
    </div>
  </nav>

  <div class="container my-5">
    <h3 class="mb-4 fw-bold">🛒 ตะกร้าสินค้าของคุณ</h3>

    <% if (successMessage) { %>
      <div class="alert alert-success">
        <h5>✅ <%= successMessage %></h5>
        <p class="mb-0">ระบบได้บันทึกคำสั่งซื้อลงฐานข้อมูล MongoDB (คอลเลกชัน orders) เรียบร้อยแล้ว</p>
      </div>
    <% } %>

    <% if (cart.length === 0) { %>
      <div class="card p-5 text-center border-0 shadow-sm">
        <p class="text-muted fs-5">ยังไม่มีสินค้าในตะกร้า</p>
        <a href="/" class="btn btn-primary align-self-center">ไปหน้าร้านค้า</a>
      </div>
    <% } else { %>
      <div class="row g-4">
        <div class="col-lg-8">
          <div class="card border-0 shadow-sm p-3 table-responsive">
            <table class="table align-middle mb-0">
              <thead>
                <tr>
                  <th>สินค้า</th>
                  <th>ราคา/ชิ้น</th>
                  <th>จำนวน</th>
                  <th>รวม</th>
                  <th></th>
                </tr>
              </thead>
              <tbody>
                <% cart.forEach(item => { %>
                  <tr>
                    <td><%= item.name %></td>
                    <td>฿<%= item.price.toLocaleString() %></td>
                    <td><%= item.quantity %></td>
                    <td class="fw-bold">฿<%= (item.price * item.quantity).toLocaleString() %></td>
                    <td>
                      <form action="/cart/remove/<%= item.productId %>" method="POST">
                        <button type="submit" class="btn btn-sm btn-outline-danger">ลบ</button>
                      </form>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>

        <div class="col-lg-4">
          <div class="card border-0 shadow-sm p-4">
            <h5 class="fw-bold">สรุปยอดสั่งซื้อ</h5>
            <h3 class="text-primary fw-bold my-3">฿<%= totalAmount.toLocaleString() %></h3>
            <% if (!user) { %>
              <div class="alert alert-warning small">กรุณาเข้าสู่ระบบก่อนกดยืนยันการสั่งซื้อ</div>
              <a href="/login" class="btn btn-primary w-100">เข้าสู่ระบบเพื่อสั่งซื้อ</a>
            <% } else { %>
              <form action="/checkout" method="POST">
                <div class="mb-3">
                  <label class="form-label">ชื่อผู้รับสินค้า (ข้อมูลสมมติ)</label>
                  <input type="text" name="customerName" class="form-control" value="<%= user.fullName %>" required>
                </div>
                <div class="mb-3">
                  <label class="form-label">ที่อยู่จัดส่ง (ข้อมูลสมมติ)</label>
                  <textarea name="shippingAddress" class="form-control" rows="2" required>99/9 ถ.แจ้งวัฒนะ อ.ปากเกร็ด จ.นนทบุรี</textarea>
                </div>
                <button type="submit" class="btn btn-success w-100 btn-lg">ยืนยันคำสั่งซื้อ</button>
              </form>
            <% } %>
          </div>
        </div>
      </div>
    <% } %>
  </div>
</body>
</html>