<%- include('partials/header') %>

<h3 class="fw-bold mb-4">🛒 ตะกร้าสินค้าของคุณ</h3>

<% if (!cart || cart.items.length === 0) { %>
    <div class="alert alert-warning text-center py-5">
        <h5>ยังไม่มีสินค้าในตะกร้า</h5>
        <a href="/" class="btn btn-red mt-3">ไปเลือกซื้ออุปกรณ์ไอที</a>
    </div>
<% } else { %>
    <div class="card shadow-sm p-3">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>สินค้า</th>
                    <th>ราคาต่อชิ้น</th>
                    <th>จำนวน</th>
                    <th>รวม</th>
                    <th>จัดการ</th>
                </tr>
            </thead>
            <tbody>
                <% cart.items.forEach(item => { %>
                    <tr>
                        <td>
                            <img src="<%= item.image %>" width="50" class="me-2">
                            <strong><%= item.name %></strong>
                        </td>
                        <td>฿<%= item.price.toLocaleString() %></td>
                        <td><div class="d-inline-flex align-items-center gap-1">
        <form action="/cart/update/<%= item.productId %>" method="POST" class="d-inline">
            <input type="hidden" name="action" value="decrease">
            <button type="submit" class="btn btn-sm btn-outline-secondary fw-bold px-2">-</button>
        </form>
        <span class="px-2 fw-bold"><%= item.qty %></span>
        <form action="/cart/update/<%= item.productId %>" method="POST" class="d-inline">
            <input type="hidden" name="action" value="increase">
            <button type="submit" class="btn btn-sm btn-outline-secondary fw-bold px-2">+</button>
        </form>
    </div></td>
                        <td class="text-danger fw-bold">฿<%= (item.price * item.qty).toLocaleString() %></td>
                        <td>
                            <form action="/cart/remove/<%= item.productId %>" method="POST">
                                <button class="btn btn-sm btn-outline-danger">ลบ</button>
                            </form>
                            
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>

        <div class="d-flex justify-content-between align-items-center mt-3">
            <h4>ยอดรวมทั้งหมด: <span class="text-danger fw-bold">฿<%= cart.totalPrice.toLocaleString() %></span></h4>
            <div>
                <a href="/" class="btn btn-outline-secondary me-2">เลือกซื้อต่อ</a>
                <!-- กดปุ่มนี้เพื่อเปลี่ยนหน้าไปหน้าเลือกวิธีชำระเงิน -->
                <a href="/checkout" class="btn btn-red btn-lg">ดำเนินการชำระเงิน ➔</a>
            </div>
        </div>
    </div>
<% } %>

<%- include('partials/footer') %>