<%- include('partials/header') %>

<div class="row justify-content-center my-5">
    <div class="col-md-5">
        <div class="card shadow p-4">
            <h3 class="text-center fw-bold mb-4">เข้าสู่ระบบ</h3>
            
            <% if (typeof error !== 'undefined' && error) { %>
                <div class="alert alert-danger"><%= error %></div>
            <% } %>

            <form action="/login" method="POST">
                <div class="mb-3">
                    <label class="form-label">ชื่อผู้ใช้ (Username)</label>
                    <input type="text" name="username" class="form-control" required placeholder="กรอกชื่อผู้ใช้">
                </div>
                <div class="mb-3">
                    <label class="form-label">รหัสผ่าน (Password)</label>
                    <input type="password" name="password" class="form-control" required placeholder="กรอกรหัสผ่าน">
                </div>
                <button type="submit" class="btn btn-red w-100">เข้าสู่ระบบ</button>
            </form>

            <div class="mt-3 p-2 bg-light rounded small text-muted">
                <strong>สำหรับทดสอบส่งอาจารย์:</strong><br>
                - Admin: <code>admin</code> / รหัส <code>1234</code><br>
                - ลูกค้า: <code>user1</code> / รหัส <code>1234</code>
            </div>
        </div>
    </div>
</div>

<%- include('partials/footer') %>