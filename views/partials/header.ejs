<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>iTechStore - ร้านขายอุปกรณ์ไอทีครบวงจร</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Prompt:wght@300;400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-dark navbar-it sticky-top">
    <div class="container">
        <a class="navbar-brand brand-logo" href="/">iTech<span>Store</span></a>
        
        <!-- ฟอร์มค้นหาสินค้า (ส่งค่า q ไปที่ Route GET /) -->
        <form class="d-flex mx-auto w-50" action="/" method="GET">
            <input class="form-control me-2" type="search" name="search" placeholder="ค้นหา CPU, การ์ดจอ, โน้ตบุ๊ก...">
            <button class="btn btn-red" type="submit">ค้นหา</button>
        </form>

        <div class="d-flex align-items-center gap-3">
            <!-- ปุ่มตะกร้าสินค้า -->
            <a href="/cart" class="btn btn-outline-light position-relative">
                🛒 ตะกร้า
                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                    <%= typeof cartCount !== 'undefined' ? cartCount : 0 %>
                </span>
            </a>

            <!-- เช็กสถานะ Login -->
            <% if (typeof user !== 'undefined' && user) { %>
                <% if (user.role === 'admin') { %>
                    <a href="/admin" class="btn btn-warning btn-sm fw-bold">จัดการร้าน (Admin)</a>
                <% } %>
                <span class="text-white small">สวัสดี, <%= user.username %></span>
                <a href="/logout" class="btn btn-sm btn-secondary">ออก</a>
            <% } else { %>
                <a href="/login" class="btn btn-red btn-sm">เข้าสู่ระบบ</a>
            <% } %>
        </div>
    </div>
</nav>
<div class="container my-4">