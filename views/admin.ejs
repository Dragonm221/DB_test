<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ระบบจัดการร้านค้า (Admin) - IT Store</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
  <nav class="navbar navbar-dark bg-dark">
    <div class="container">
      <a class="navbar-brand fw-bold" href="/admin">⚙️ Admin Dashboard - IT Store</a>
      <div class="d-flex gap-2">
        <a href="/" class="btn btn-outline-light btn-sm">ดูหน้าร้าน</a>
        <a href="/logout" class="btn btn-danger btn-sm">ออกจากระบบ</a>
      </div>
    </div>
  </nav>

  <div class="container my-4">
    <!-- ฟอร์มเพิ่มสินค้าใหม่ -->
    <div class="card border-0 shadow-sm p-4 mb-4">
      <h5 class="fw-bold mb-3">➕ เพิ่มสินค้าใหม่เข้า MongoDB</h5>
      <form action="/admin/products/add" method="POST" class="row g-3">
        <div class="col-md-4">
          <input type="text" name="name" class="form-control" placeholder="ชื่อสินค้า" required>
        </div>
        <div class="col-md-2">
          <input type="text" name="category" class="form-control" placeholder="หมวดหมู่ (เช่น CPU)" required>
        </div>
        <div class="col-md-2">
          <input type="number" name="price" class="form-control" placeholder="ราคา (บาท)" required>
        </div>
        <div class="col-md-2">
          <input type="number" name="stock" class="form-control" placeholder="จำนวนสต็อก" required>
        </div>
        <div class="col-md-2">
          <input type="text" name="imageUrl" class="form-control" value="https://placehold.co/600x400/1e293b/ffffff?text=New+Product" placeholder="URL รูปภาพ" required>
        </div>
        <div class="col-md-10">
          <input type="text" name="description" class="form-control" placeholder="รายละเอียดสินค้า">
        </div>
        <div class="col-md-2 d-grid">
          <button type="submit" class="btn btn-success">เพิ่มสินค้า</button>
        </div>
      </form>
    </div>

    <!-- ตารางจัดการสินค้าทั้งหมด -->
    <div class="card border-0 shadow-sm p-4 mb-4">
      <h5 class="fw-bold mb-3">📦 จัดการรายการสินค้าทั้งหมด (<%= products.length %> รายการ)</h5>
      <div class="table-responsive">
        <table class="table table-hover align-middle">
          <thead class="table-dark">
            <tr>
              <th>รูป</th>
              <th>ชื่อสินค้า</th>
              <th>หมวดหมู่</th>
              <th>ราคา</th>
              <th>สต็อก</th>
              <th>จัดการ</th>
            </tr>
          </thead>
          <tbody>
            <% products.forEach(p => { %>
              <tr>
                <td><img src="<%= p.imageUrl %>" width="60" height="40" style="object-fit: cover;" class="rounded" onerror="this.src='https://placehold.co/60x40'"></td>
                <td><%= p.name %></td>
                <td><span class="badge bg-secondary"><%= p.category %></span></td>
                <td>฿<%= (p.price || 0).toLocaleString() %></td>
                <td><%= p.stock %></td>
                <td>
                  <button class="btn btn-warning btn-sm" data-bs-toggle="modal" data-bs-target="#editModal<%= p._id %>">แก้ไข</button>
                  <form action="/admin/products/delete/<%= p._id %>" method="POST" class="d-inline" onsubmit="return confirm('ยืนยันการลบสินค้านี้?');">
                    <button type="submit" class="btn btn-danger btn-sm">ลบ</button>
                  </form>
                </td>
              </tr>

              <!-- Modal แก้ไขสินค้า -->
              <div class="modal fade" id="editModal<%= p._id %>" tabindex="-1">
                <div class="modal-dialog">
                  <form action="/admin/products/edit/<%= p._id %>" method="POST" class="modal-content">
                    <div class="modal-header">
                      <h5 class="modal-title">แก้ไขสินค้า</h5>
                      <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                      <div class="mb-2">
                        <label class="form-label">ชื่อสินค้า</label>
                        <input type="text" name="name" class="form-control" value="<%= p.name %>" required>
                      </div>
                      <div class="mb-2">
                        <label class="form-label">หมวดหมู่</label>
                        <input type="text" name="category" class="form-control" value="<%= p.category %>" required>
                      </div>
                      <div class="row">
                        <div class="col-6 mb-2">
                          <label class="form-label">ราคา</label>
                          <input type="number" name="price" class="form-control" value="<%= p.price %>" required>
                        </div>
                        <div class="col-6 mb-2">
                          <label class="form-label">สต็อก</label>
                          <input type="number" name="stock" class="form-control" value="<%= p.stock %>" required>
                        </div>
                      </div>
                      <div class="mb-2">
                        <label class="form-label">URL รูปภาพ</label>
                        <input type="text" name="imageUrl" class="form-control" value="<%= p.imageUrl %>" required>
                      </div>
                      <div class="mb-2">
                        <label class="form-label">รายละเอียด</label>
                        <input type="text" name="description" class="form-control" value="<%= p.description %>">
                      </div>
                    </div>
                    <div class="modal-footer">
                      <button type="submit" class="btn btn-primary">บันทึกการแก้ไข</button>
                    </div>
                  </form>
                </div>
              </div>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- รายการคำสั่งซื้อล่าสุดจากลูกค้า -->
    <div class="card border-0 shadow-sm p-4">
      <h5 class="fw-bold mb-3">🧾 คำสั่งซื้อล่าสุดจากลูกค้า (<%= orders.length %> รายการ)</h5>
      <div class="table-responsive">
        <table class="table table-sm">
          <thead>
            <tr>
              <th>รหัสออเดอร์</th>
              <th>ชื่อลูกค้า</th>
              <th>รายการที่สั่ง</th>
              <th>ยอดรวม</th>
              <th>วันที่สั่ง</th>
            </tr>
          </thead>
          <tbody>
            <% orders.forEach(o => { %>
              <tr>
                <td><code><%= o._id %></code></td>
                <td><%= o.customerName %></td>
                <td><%= o.items.map(i => `${i.name} (x${i.quantity})`).join(', ') %></td>
                <td class="fw-bold text-success">฿<%= (o.totalAmount || 0).toLocaleString() %></td>
                <td><%= new Date(o.createdAt).toLocaleString('th-TH') %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>