<%- include('partials/header') %>

<% const allCategories = [...new Set(['CPU', 'GPU', 'RAM', 'Monitor', 'Gaming Gear', ...(categories || [])])]; %>

<h3 class="fw-bold mb-4">⚙️ ระบบจัดการสินค้าหลังบ้าน (Admin Dashboard)</h3>

<!-- ฟอร์มเพิ่มสินค้าใหม่เข้า MongoDB -->
<div class="card p-4 shadow-sm mb-4">
    <h5 class="fw-bold text-danger mb-3">+ เพิ่มอุปกรณ์ไอทีใหม่</h5>
    <form action="/admin/add" method="POST" class="row g-3">
        <div class="col-md-4">
            <input type="text" name="name" class="form-control" placeholder="ชื่อสินค้า เช่น Intel Core i7-14700K" required>
        </div>
        <div class="col-md-2">
            <select name="category" class="form-select" required>
                <% allCategories.forEach(cat => { %>
                    <option value="<%= cat %>"><%= cat %></option>
                <% }) %>
            </select>
        </div>
        <div class="col-md-2">
            <input type="number" name="price" class="form-control" placeholder="ราคา (บาท)" required>
        </div>
        <div class="col-md-2">
            <input type="number" name="stock" class="form-control" placeholder="จำนวนสต็อก" required>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-success w-100">บันทึกสินค้า</button>
        </div>
        <div class="col-md-6">
            <input type="text" name="image" class="form-control" placeholder="ลิงก์รูปภาพ (URL)" required>
        </div>
        <div class="col-md-6">
            <input type="text" name="description" class="form-control" placeholder="รายละเอียดสเปกสินค้า">
        </div>
    </form>
</div>

<!-- ตารางแก้ไข / ลบสินค้าที่มีอยู่ใน MongoDB -->
<div class="card p-3 shadow-sm mb-4">
    <h5 class="fw-bold mb-3">รายการสินค้าทั้งหมดในฐานข้อมูล (<%= products.length %> รายการ)</h5>
    <div class="table-responsive">
        <table class="table table-bordered align-middle">
            <thead class="table-dark">
                <tr>
                    <th>รูป</th>
                    <th>ชื่อสินค้า / รูป / รายละเอียด</th>
                    <th>หมวดหมู่</th>
                    <th>ราคา (บาท)</th>
                    <th>สต็อก</th>
                    <th>จัดการ</th>
                </tr>
            </thead>
            <tbody>
                <% products.forEach(item => { %>
                    <tr>
                        <form action="/admin/update/<%= item._id %>" method="POST">
                            <td style="width: 70px;">
                                <img src="<%= item.image %>" alt="<%= item.name %>" class="img-thumbnail" style="width: 56px; height: 42px; object-fit: cover;" onerror="this.src='https://placehold.co/60x40'">
                            </td>
                            <td>
                                <input type="text" name="name" value="<%= item.name %>" class="form-control form-control-sm mb-1" placeholder="ชื่อสินค้า" required>
                                <input type="text" name="image" value="<%= item.image %>" class="form-control form-control-sm mb-1" placeholder="URL รูปภาพ">
                                <input type="text" name="description" value="<%= item.description || '' %>" class="form-control form-control-sm" placeholder="รายละเอียดสินค้า">
                            </td>
                            <td style="width: 140px;">
                                <select name="category" class="form-select form-select-sm">
                                    <% allCategories.forEach(cat => { %>
                                        <option value="<%= cat %>" <%= item.category === cat ? 'selected' : '' %>><%= cat %></option>
                                    <% }) %>
                                </select>
                            </td>
                            <td style="width: 120px;">
                                <input type="number" name="price" value="<%= item.price %>" min="0" class="form-control form-control-sm" required>
                            </td>
                            <td style="width: 100px;">
                                <input type="number" name="stock" value="<%= item.stock %>" min="0" class="form-control form-control-sm" required>
                            </td>
                            <td style="width: 130px;" class="text-nowrap">
                                <button type="submit" class="btn btn-primary btn-sm">อัปเดต</button>
                                <button type="submit" formaction="/admin/delete/<%= item._id %>" formmethod="POST" onclick="return confirm('ยืนยันการลบสินค้านี้?')" class="btn btn-danger btn-sm">ลบ</button>
                            </td>
                        </form>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
</div>

<!-- ตารางรายการคำสั่งซื้อล่าสุดจากลูกค้า -->
<div class="card p-3 shadow-sm">
    <h5 class="fw-bold mb-3">🧾 รายการคำสั่งซื้อล่าสุด (<%= (orders || []).length %> รายการ)</h5>
    <div class="table-responsive">
        <table class="table table-sm align-middle">
            <thead>
                <tr>
                    <th>รหัสออเดอร์</th>
                    <th>ลูกค้า / เบอร์โทร</th>
                    <th>รายการที่สั่ง</th>
                    <th>ช่องทางชำระเงิน</th>
                    <th>ยอดรวม</th>
                </tr>
            </thead>
            <tbody>
                <% (orders || []).forEach(o => { %>
                    <tr>
                        <td><code><%= o._id %></code></td>
                        <td><%= o.customerName %> (<%= o.phone %>)</td>
                        <td><%= o.items.map(i => `${i.name} (x${i.quantity})`).join(', ') %></td>
                        <td><span class="badge bg-info text-dark"><%= o.paymentMethod %></span></td>
                        <td class="fw-bold text-danger">฿<%= (o.totalAmount || 0).toLocaleString() %></td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
</div>

<%- include('partials/footer') %>