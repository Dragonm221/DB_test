<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>IT Store - ร้านขายอุปกรณ์และอะไหล่คอมพิวเตอร์</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
  <nav class="navbar navbar-expand-lg navbar-dark bg-dark sticky-top">
    <div class="container">
      <a class="navbar-brand fw-bold" href="/">🖥️ IT Store</a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="navbarNav">
        <ul class="navbar-nav ms-auto align-items-center gap-2">
          <li class="nav-item"><a class="nav-link active" href="/">สินค้าทั้งหมด</a></li>
          <li class="nav-item">
            <a class="nav-link" href="/cart">🛒 ตะกร้า (<%= cart.reduce((s, i) => s + i.quantity, 0) %>)</a>
          </li>
          <% if (user) { %>
            <% if (user.role === 'admin') { %>
              <li class="nav-item"><a class="btn btn-warning btn-sm" href="/admin">จัดการระบบ (Admin)</a></li>
            <% } %>
            <li class="nav-item"><span class="text-light small">สวัสดี, <%= user.fullName %></span></li>
            <li class="nav-item"><a class="btn btn-outline-light btn-sm" href="/logout">ออกจากระบบ</a></li>
          <% } else { %>
            <li class="nav-item"><a class="btn btn-primary btn-sm" href="/login">เข้าสู่ระบบ</a></li>
          <% } %>
        </ul>
      </div>
    </div>
  </nav>

  <div class="container my-4">
    <!-- ฟอร์มค้นหาและกรองหมวดหมู่ -->
    <form action="/" method="GET" class="row g-2 mb-4 bg-white p-3 rounded shadow-sm">
      <div class="col-md-6">
        <input type="text" name="search" class="form-control" placeholder="ค้นหาชื่อสินค้า เช่น คีย์บอร์ด, การ์ดจอ..." value="<%= search %>">
      </div>
      <div class="col-md-4">
        <select name="category" class="form-select">
          <option value="all" <%= selectedCategory === 'all' ? 'selected' : '' %>>ทุกหมวดหมู่</option>
          <% categories.forEach(cat => { %>
            <option value="<%= cat %>" <%= selectedCategory === cat ? 'selected' : '' %>><%= cat %></option>
          <% }) %>
        </select>
      </div>
      <div class="col-md-2 d-grid">
        <button type="submit" class="btn btn-primary">ค้นหา / กรอง</button>
      </div>
    </form>

    <div class="d-flex justify-content-between align-items-center mb-3">
      <h4 class="mb-0">รายการสินค้า (<%= products.length %> รายการ)</h4>
      <% if (search || selectedCategory !== 'all') { %>
        <a href="/" class="btn btn-sm btn-outline-secondary">ล้างตัวกรอง</a>
      <% } %>
    </div>

    <!-- แสดงรายการสินค้า -->
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
      <% products.forEach(product => { %>
        <div class="col">
          <div class="card h-100 shadow-sm border-0">
            <img src="<%= product.imageUrl %>" class="card-img-top" alt="<%= product.name %>" style="height: 180px; object-fit: cover;" onerror="this.src='https://placehold.co/600x400?text=IT+Store'">
            <div class="card-body d-flex flex-column">
              <span class="badge bg-secondary align-self-start mb-2"><%= product.category %></span>
              <h6 class="card-title fw-bold"><%= product.name %></h6>
              <p class="text-primary fw-bold fs-5 mb-1">฿<%= (product.price || 0).toLocaleString() %></p>
              <p class="text-muted small mb-3">คงเหลือ: <%= product.stock %> ชิ้น</p>
              <div class="mt-auto d-grid gap-2">
                <a href="/product/<%= product._id %>" class="btn btn-outline-dark btn-sm">ดูรายละเอียด</a>
                <form action="/cart/add/<%= product._id %>" method="POST">
                  <button type="submit" class="btn btn-primary btn-sm w-100" <%= product.stock <= 0 ? 'disabled' : '' %>>
                    <%= product.stock > 0 ? 'ใส่ตะกร้า' : 'สินค้าหมด' %>
                  </button>
                </form>
              </div>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  </div>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>