<%- include('partials/header') %>

<!-- แบนเนอร์โปรโมชั่นสไตล์ร้านไอที -->
<div class="p-4 p-md-5 mb-4 rounded text-white bg-dark" style="background: linear-gradient(90deg, #111 0%, #800000 100%);">
    <div class="col-md-8">
        <h1 class="display-5 fw-bold">อัปเกรดสเปกคอมแรงระดับโปร</h1>
        <p class="lead my-3">รวมอุปกรณ์ไอทีครบวงจร CPU, GPU, Mainboard, RAM และ Gaming Gear ของแท้ประกันศูนย์</p>
    </div>
</div>

<!-- ปุ่มกรองตามหมวดหมู่ (ดึงหมวดหมู่จริงทั้งหมดจาก MongoDB) -->
<div class="mb-4 d-flex flex-wrap gap-2">
    <a href="/" class="btn <%= !selectedCategory ? 'btn-dark' : 'btn-outline-dark' %> btn-sm">ทั้งหมด</a>
    <% categories.forEach(cat => { %>
        <a href="/?category=<%= encodeURIComponent(cat) %>" class="btn <%= selectedCategory === cat ? 'btn-dark' : 'btn-outline-dark' %> btn-sm"><%= cat %></a>
    <% }) %>
</div>

<!-- รายการสินค้าจาก MongoDB -->
<div class="row row-cols-1 row-cols-md-4 g-4">
    <% products.forEach(product => { %>
        <div class="col">
            <div class="card h-100 product-card">
                <img src="<%= product.image %>" class="card-img-top p-3" alt="<%= product.name %>" style="height: 200px; object-fit: contain;" onerror="this.src='https://placehold.co/600x400?text=IT+Store'">
                <div class="card-body d-flex flex-column">
                    <span class="badge bg-secondary w-50 mb-2"><%= product.category %></span>
                    <h6 class="card-title fw-bold"><%= product.name %></h6>
                    <p class="price-tag mt-auto mb-2">฿<%= product.price.toLocaleString() %></p>
                    <p class="text-muted small mb-3">คงเหลือ: <%= product.stock %> ชิ้น</p>
                    
                    <div class="d-grid gap-2">
                        <a href="/product/<%= product._id %>" class="btn btn-outline-dark btn-sm">ดูรายละเอียด</a>
                        <form action="/cart/add/<%= product._id %>" method="POST">
                            <% if (product.stock > 0) { %>
                                <div class="input-group input-group-sm mb-2">
                                    <button type="button" class="btn btn-outline-secondary fw-bold" onclick="stepQty(this, -1)">-</button>
                                    <input type="number" name="quantity" value="1" min="1" max="<%= product.stock %>" class="form-control text-center fw-bold">
                                    <button type="button" class="btn btn-outline-secondary fw-bold" onclick="stepQty(this, 1)">+</button>
                                </div>
                            <% } %>
                            <button type="submit" class="btn btn-red btn-sm w-100" <%= product.stock <= 0 ? 'disabled' : '' %>>
                                <%= product.stock > 0 ? '+ ใส่ตะกร้า' : 'สินค้าหมด' %>
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    <% }) %>
</div>

<script>
function stepQty(btn, delta) {
    const inp = btn.parentElement.querySelector('input[name="quantity"]');
    if (!inp) return;
    const min = Number(inp.min) || 1;
    const max = Number(inp.max) || 999;
    const next = (Number(inp.value) || min) + delta;
    if (next >= min && next <= max) {
        inp.value = next;
    }
}
</script>
<%- include('partials/footer') %>